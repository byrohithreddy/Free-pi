{
  "name": "upi-orchestrator-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute upi-payments --remote --file=./schema.sql",
    "db:verify": "wrangler d1 execute upi-payments --remote --command=\"SELECT name FROM sqlite_master WHERE type='table' ORDER BY name;\""
  },
  "dependencies": {},
  "devDependencies": {
    "wrangler": "^4.14.0"
  }
}
